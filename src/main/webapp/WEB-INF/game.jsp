<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,shiritori.web.GameServlet,shiritori.web.GameData,shiritori.web.GameData.*" %>
<% GameData data=(GameData)request.getAttribute("data");Player player=(Player)request.getAttribute("player");Match match=(Match)request.getAttribute("match");String base=request.getContextPath(),csrf=(String)session.getAttribute("csrf");long remaining=data.remainingMillis(match);boolean expired=!match.finished&&remaining==0;Word last=data.last(match);Character next=data.next(match); %>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ジャンルしりとり | 対戦</title><link rel="stylesheet" href="<%=base%>/css/style.css"><script src="<%=base%>/js/game.js" defer></script></head><body><div class="shell gameShell"><header class="top"><a class="brand" href="<%=base%>/game?screen=menu"><img src="<%=base%>/images/logo.svg" alt="" width="42" height="42"><span>ジャンルしりとり<small>ことばをつないで、CPUに挑戦。</small></span></a><a class="textLink" href="<%=base%>/game?screen=menu">メニューへ</a></header><main>
<div class="gameHeader"><div><p class="eyebrow"><%=GameServlet.html(GameData.GENRES.get(match.genre))%></p><h1><%=GameServlet.html(player.name)%> vs CPU</h1></div><span class="badge"><%=match.difficulty.equals("NORMAL")?"ふつう":"やさしい"%></span></div>
<% if(request.getAttribute("message")!=null){ %><p class="notice" role="status"><%=GameServlet.html(request.getAttribute("message"))%></p><% } %>
<% if(match.finished){ %><section class="result card"><p class="eyebrow">GAME RESULT</p><h2><%=match.playerWon?"あなたの勝ち！":"あなたの負け"%></h2><p><%=GameServlet.html(match.reason)%></p><p>回答 <%=match.answerCount()%>語 ／ パス <%=match.passCount()%>回</p><a class="button" href="<%=base%>/game?screen=menu">メニューでもう一度遊ぶ</a></section><% } else { %>
<section class="card playCard" id="playArea" data-remaining="<%=remaining%>" data-endpoint="<%=base%>/game?action=status&amp;matchId=<%=match.id%>" data-turn="<%=match.turn%>">
<div class="sectionHead"><h2><%=next==null?"最初の言葉は自由である。":"次は「"+next+"」から。"%></h2><span class="muted">制限時間 <%=data.seconds%>秒</span></div>
<p class="lastWord">直前：<%=last==null?"まだ回答がない。":GameServlet.html(last.label())%></p><div class="warningSpace" aria-live="polite"><p id="timeWarning" class="timeWarning" hidden>残り10秒である。詰まったらパスできる。</p></div>
<form id="answerForm" class="<%=expired?"hidden":""%>" method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="answer"><input type="hidden" name="matchId" value="<%=match.id%>"><input type="hidden" name="turn" value="<%=match.turn%>"><label for="word">あなたの回答</label><div class="answerRow"><input id="word" name="word" maxlength="200" autocomplete="off" autofocus required placeholder="言葉を入力する" value="<%=GameServlet.html(session.getAttribute("lastInput"))%>"><button>回答する</button></div>
<% Object list=session.getAttribute("candidates");if(list instanceof List<?>){ %><label for="chosenId">同じ入力の候補</label><select name="chosenId" id="chosenId" required><option value="">候補を選択する</option><% for(Object item:(List<?>)list){Word w=(Word)item; %><option value="<%=w.id%>"><%=GameServlet.html(w.label())%></option><% } %></select><% } %></form>
<p id="timeoutMessage" class="notice <%=expired?"":"hidden"%>" role="status">時間切れである。下の「パス」または「ギブアップ」を選択する。</p>
<div class="actions"><form method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="pass"><input type="hidden" name="matchId" value="<%=match.id%>"><input type="hidden" name="turn" value="<%=match.turn%>"><button class="secondary">パスする</button></form><form method="post" action="<%=base%>/game" data-confirm="ギブアップして対戦を終了する。よいか。"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="giveup"><input type="hidden" name="matchId" value="<%=match.id%>"><input type="hidden" name="turn" value="<%=match.turn%>"><button class="danger">ギブアップ</button></form></div>
<p class="muted">パスは直前の言葉からCPUへ渡す。回答はEnterでも送信できる。</p><noscript><p class="notice">通知表示にはJavaScriptが必要である。制限時間はサーバーで判定するため、時間切れ後の回答は受理されない。</p></noscript>
</section><section class="saveSection"><form class="saveForm" method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="save"><input type="hidden" name="matchId" value="<%=match.id%>"><input type="hidden" name="turn" value="<%=match.turn%>"><% if(data.db.saves.containsKey(player.id)){ %><label class="check"><input type="checkbox" name="overwrite" value="yes" required>既存の中断セーブを上書きする。</label><% } %><button class="quiet">保存してメニューへ</button></form></section>
<% } %>
<section class="card section"><div class="sectionHead"><h2>対戦履歴</h2><span class="muted">回答 <%=match.answerCount()%>語 ／ パス <%=match.passCount()%>回</span></div><% if(match.moves.isEmpty()){ %><p class="muted">最初の回答を入力する。</p><% } %><ol class="history"><% for(Move move:match.moves){ %><li class="<%=move.actor.equals("CPU")?"cpu":"player"%>"><span class="actor"><%=move.actor.equals("CPU")?"CPU":"あなた"%></span><span><%=move.pass?"パス":GameServlet.html(data.words.get(move.wordId).label())%></span></li><% } %></ol><% if(!match.finished){ %><p class="muted">この難易度で使用可能：<%=data.remaining(player,match)%>語（全開始文字の合計）</p><% } %></section>
<p class="muted"><a href="<%=base%>/game?screen=menu#dictionary">未登録の言葉を辞書に追加する</a>（対戦時間は進む）</p><details class="card section"><summary>ルールを確認する</summary><p>未登録・開始文字違い・禁止された再使用は再入力である。入力ミスや画面更新で制限時間は延長しない。</p><p>「ふつう」ではこの対戦の全使用語と自分の過去回答を禁止する。「やさしい」は再使用できる。</p><p>有効な回答は自動で累積履歴に保存する。対戦の中断再開は「保存してメニューへ」を使う。</p></details></main><footer><%=GameServlet.VERSION%></footer></div></body></html>
