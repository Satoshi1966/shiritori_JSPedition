<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,shiritori.web.GameServlet,shiritori.web.GameData,shiritori.web.GameData.*" %>
<% if(request.getAttribute("viewReady")==null){response.sendRedirect(request.getContextPath()+"/game?screen=menu");return;}
GameData data=(GameData)request.getAttribute("data");Player player=(Player)request.getAttribute("player");Match match=(Match)request.getAttribute("match");
String base=request.getContextPath(),csrf=(String)session.getAttribute("csrf");boolean active=match!=null&&!match.finished;
%>
<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ジャンルしりとり | メニュー</title><link rel="stylesheet" href="<%=base%>/css/style.css"><script src="<%=base%>/js/game.js" defer></script></head>
<body><div class="shell"><header class="top"><a class="brand" href="<%=base%>/index.jsp"><img src="<%=base%>/images/logo.svg" alt="" width="42" height="42"><span>ジャンルしりとり<small>ことばをつないで、CPUに挑戦。</small></span></a><span class="badge">Servlet / JSP版</span></header>
<main><section class="intro"><p class="eyebrow">WORD CHAIN GAME</p><h1>好きなジャンルで、<br>しりとり対戦。</h1><p>30秒のシンキングタイム。詰まったら、いつでもパスできる。</p></section>
<% if(request.getAttribute("message")!=null){ %><p class="notice" role="status"><%=GameServlet.html(request.getAttribute("message"))%></p><% } %>
<div class="grid"><section class="card"><h2>1 プレイヤーを選ぶ</h2>
<form method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="select"><label for="player">登録済みプレイヤー</label><div class="inline"><select id="player" name="playerId" required><option value="">選択する</option><% for(Player p:data.db.players){ %><option value="<%=p.id%>" <%=player!=null&&player.id.equals(p.id)?"selected":""%>><%=GameServlet.html(p.name)%> · <%=p.id.substring(0,8)%></option><% } %></select><button class="secondary" <%=active?"disabled":""%>>選択</button></div></form>
<details><summary>新しいプレイヤーを登録</summary><form method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="create"><label for="newName">名前</label><div class="inline"><input id="newName" name="name" maxlength="30" required placeholder="30文字まで"><button class="secondary" <%=active?"disabled":""%>>登録</button></div></form></details>
<p class="muted"><%=player==null?"プレイヤーを登録または選択してから対戦する。":"選択中："+GameServlet.html(player.name)%></p>
<% if(active){ %><p class="notice">進行中の対戦がある。</p><a class="button" href="<%=base%>/game">対戦へ戻る</a><% } %></section>
<section class="card"><h2>2 対戦をはじめる</h2><form method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="new"><label for="genre">ジャンル</label><select id="genre" name="genre"><% for(Map.Entry<String,String> entry:GameData.GENRES.entrySet()){ %><option value="<%=entry.getKey()%>"><%=entry.getValue()%></option><% } %></select><label for="difficulty">難易度</label><select id="difficulty" name="difficulty"><option value="EASY">やさしい · 再使用できる</option><option value="NORMAL">ふつう · 使用済みと過去の自分の回答は禁止</option></select><button class="wide" <%=player==null||active?"disabled":""%>>新しい対戦をはじめる <span aria-hidden="true">→</span></button></form>
<% if(player!=null){ Match saved=data.db.saves.get(player.id); %><form method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="resume"><button class="secondary wide" <%=saved==null||active?"disabled":""%>>保存した対戦から再開</button></form><% if(saved!=null){ %><p class="muted">保存：<%=GameServlet.html(GameData.GENRES.get(saved.genre))%><br><%=GameServlet.html(saved.savedAt)%></p><% }} %></section></div>
<% if(player!=null){ int wins=0,total=0;for(Score score:data.db.scores)if(score.playerId.equals(player.id)){total++;if(score.won)wins++;} %>
<section class="card section"><div class="sectionHead"><h2><%=GameServlet.html(player.name)%>の記録</h2><span class="badge"><%=total%>戦 <%=wins%>勝 <%=total-wins%>敗</span></div><p class="muted">勝率：<%=total==0?"未算出":String.format(java.util.Locale.ROOT,"%.1f%%",100.0*wins/total)%> ／ やさしいで回答した言葉も累積履歴に残る。</p><div class="tableWrap"><table><thead><tr><th>ジャンル</th><th>辞書総数</th><th>回答済み</th><th>未回答</th></tr></thead><tbody><% for(Map.Entry<String,String> entry:GameData.GENRES.entrySet()){int count=data.all(entry.getKey()).size(),left=data.remaining(player,entry.getKey()); %><tr><td><%=entry.getValue()%></td><td><%=count%></td><td><%=count-left%></td><td><%=left%></td></tr><% } %></tbody></table></div>
<details><summary>累積回答履歴を見る</summary><% for(Map.Entry<String,String> entry:GameData.GENRES.entrySet()){ %><h3><%=entry.getValue()%></h3><div class="chips"><% if(player.used(entry.getKey()).isEmpty()){ %><span class="muted">まだ回答がない。</span><% }for(String id:new TreeSet<>(player.used(entry.getKey()))){Word word=data.words.get(id); %><span class="chip"><%=GameServlet.html(word==null?id+"（辞書にない）":word.name)%></span><% } %></div><% } %></details>
<details><summary>名前変更と履歴リセット</summary><form class="inline" method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="rename"><label for="rename">新しい名前</label><input id="rename" name="name" maxlength="30" required value="<%=GameServlet.html(player.name)%>"><button class="secondary" <%=active?"disabled":""%>>変更</button></form><form method="post" action="<%=base%>/game" data-confirm="選択ジャンルの累積回答履歴と中断セーブを削除する。よいか。"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="reset"><label for="resetGenre">リセットするジャンル</label><select id="resetGenre" name="genre"><% for(Map.Entry<String,String> entry:GameData.GENRES.entrySet()){ %><option value="<%=entry.getKey()%>"><%=entry.getValue()%></option><% } %></select><label class="check"><input type="checkbox" name="confirm" value="yes" required>指定ジャンルの累積履歴と中断セーブを削除する。戦績は残る。</label><button class="danger" <%=active?"disabled":""%>>履歴をリセット</button></form></details></section><% } %>
<section class="card section" id="dictionary"><p class="eyebrow">GROW THE DICTIONARY</p><h2>言葉を辞書に追加</h2><p class="muted">未登録の映画タイトル・曲名などを追加できる。登録後はCPUの候補にも入り、次回以降も使用できる。</p>
<form method="post" action="<%=base%>/game"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="action" value="addWord"><div class="grid"><div><label for="addGenre">ジャンル</label><select id="addGenre" name="genre"><% for(Map.Entry<String,String> entry:GameData.GENRES.entrySet()){ %><option value="<%=entry.getKey()%>" <%=active&&match.genre.equals(entry.getKey())?"selected":""%>><%=entry.getValue()%></option><% } %></select><label for="entryType">昭和ジャンルの種別</label><select id="entryType" name="entryType"><option value="SONG">曲名</option><option value="SINGER">歌手名・グループ名</option></select><p class="muted">昭和以外のジャンルでは種別を自動設定する。</p></div><div><label for="addName">正式名称</label><input id="addName" name="name" maxlength="200" required value="<%=GameServlet.html(session.getAttribute("lastInput"))%>" placeholder="映画タイトル・曲名・歌手名など"><label for="addReading">読み</label><input id="addReading" name="reading" maxlength="200" required placeholder="ひらがな、またはカタカナ"><p class="muted">英数字や記号も、しりとりに使う読みへ直して入力する。</p></div></div><label for="addAliases">別名・略称 任意</label><input id="addAliases" name="aliases" maxlength="1100" placeholder="複数ある場合は | で区切る"><p class="muted">略称も判定には正式名称の読みを使う。登録は回答そのものにはならず、対戦の制限時間は延長しない。</p><button>辞書に追加する</button></form>
<details><summary>追加した言葉を見る（<%=data.db.customWords.size()%>件）</summary><div class="tableWrap"><table><thead><tr><th>ジャンル</th><th>名称と読み</th></tr></thead><tbody><% for(Word added:data.db.customWords){ %><tr><td><%=GameServlet.html(GameData.GENRES.get(added.genre))%></td><td><%=GameServlet.html(added.label())%></td></tr><% } %></tbody></table></div></details></section>
<section class="card section"><h2>あそびかた</h2><ul class="rules"><li>正式名・かな読み・登録された別名で回答できる。略称も判定は正式名の読みを使う。</li><li>末尾の「ん」は負け。小さい文字は大きい文字に、末尾の「ー」は直前の文字として扱う。</li><li>「ふつう」では対戦内の使用済みと、自分の過去回答を再使用できない。</li><li>残り10秒で一度通知し、30秒でパスかギブアップを選択する。即時パスも可能である。</li><li>昭和ジャンルは曲名と歌手名を混ぜて回答できる。初期辞書270件に、フォームから言葉を追加できる。</li></ul></section></main><footer><%=GameServlet.VERSION%></footer></div></body></html>
